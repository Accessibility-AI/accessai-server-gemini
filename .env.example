# Service Configuration
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_PATH=voice_intent.db

# Active LLM Provider: 'gemini', 'groq', 'anthropic', or 'mock'
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API Configuration (Optional alternative)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic API Configuration (Optional alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Security & Confirmation Gate
CONFIDENCE_THRESHOLD=0.85
CONFIRMATION_TOKEN_TTL_SECONDS=60
ED25519_PRIVATE_KEY_B64=
JWKS_KID=voice-intent-key-1
