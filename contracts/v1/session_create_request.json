{
  "$defs": {
    "DeviceKey": {
      "properties": {
        "kid": {
          "description": "Key ID; confirm requests must sign with the same kid",
          "title": "Kid",
          "type": "string"
        },
        "alg": {
          "default": "ES256",
          "description": "Only ES256 (ECDSA P-256) is accepted",
          "title": "Alg",
          "type": "string"
        },
        "public_key": {
          "description": "Base64 X.509 SubjectPublicKeyInfo DER encoded ECDSA public key",
          "title": "Public Key",
          "type": "string"
        },
        "attestation_chain": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional list of base64 DER X.509 certificates proving hardware backing",
          "title": "Attestation Chain"
        }
      },
      "required": [
        "kid",
        "public_key"
      ],
      "title": "DeviceKey",
      "type": "object"
    }
  },
  "examples": [
    {
      "app_id": "accesspay-demo",
      "device_key": {
        "alg": "ES256",
        "kid": "device-1",
        "public_key": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE…"
      },
      "locale": "en-NG"
    }
  ],
  "properties": {
    "app_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Host app's public identifier",
      "title": "App Id"
    },
    "locale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "BCP 47 locale hint, e.g. en-NG, yo-NG, ha-NG",
      "title": "Locale"
    },
    "device_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Android Keystore public key. Required to confirm sensitive actions"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata"
    }
  },
  "title": "SessionCreateRequest",
  "type": "object"
}
