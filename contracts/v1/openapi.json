{
  "openapi": "3.1.0",
  "info": {
    "title": "AccessAI Server",
    "description": "\nAI service for the AccessAI Android SDK: a voice accessibility layer for blind and\nlow-vision users of fintech apps. Implements **contract v1.1**.\n\nThe service suggests actions and issues short-lived signed confirmation tokens.\n**It never moves money.** The bank verifies each token before executing anything.\n\n- Contract (behaviour rules, hashing, token claims): `contracts/v1/API_CONTRACT.md`\n- Machine-readable spec: `contracts/v1/openapi.json` and the per-model JSON schemas beside it\n\n**SDK flow:** `POST /v1/sessions` → `POST /v1/interpret` (repeat per utterance) →\n`POST /v1/confirmations` → `POST /v1/confirmations/{id}/confirm` (or `/cancel`).\nThe host's bank backend verifies the returned token with `GET /.well-known/jwks.json`.\n\nEvery non-2xx response has the body `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}`.\n",
    "version": "1.1.0"
  },
  "paths": {
    "/v1/sessions": {
      "post": {
        "tags": [
          "SDK (contract v1.1)"
        ],
        "summary": "Start a session",
        "description": "Creates a session (valid 24 hours). Register the device's Android Keystore public key\nhere (`device_key`): it is required later to confirm sensitive actions.",
        "operationId": "create_new_session_v1_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`: Missing or invalid field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "bad_request",
                    "message": "Missing or invalid field"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/interpret": {
      "post": {
        "tags": [
          "SDK (contract v1.1)"
        ],
        "summary": "Interpret one utterance",
        "description": "Turns what the user said into a structured suggestion. **Never executes anything.**\n\n`action_id` is always one of `request.actions[].id`. Params the user didn't say are left\nout, never guessed. `amount_minor` is an integer in kobo, parsed deterministically.\nUtterances containing 10+ digit runs (e.g. account numbers) are rejected with `bad_request`.",
        "operationId": "interpret_utterance_v1_interpret_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterpretRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterpretResponse"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`: Missing or invalid field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "bad_request",
                    "message": "Missing or invalid field"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`session_expired`: Unknown or expired session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "session_expired",
                    "message": "Unknown or expired session_id"
                  }
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`: The language model's rate limit was reached; retry after Retry-After seconds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limited",
                    "message": "The language model's rate limit was reached; retry after Retry-After seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "`server`: Model or server failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "server",
                    "message": "Model or server failure"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/confirmations": {
      "post": {
        "tags": [
          "SDK (contract v1.1)"
        ],
        "summary": "Create a pending confirmation",
        "description": "Called after the SDK has read the details back to the user. `params` are the\n**resolved** values the bank will receive. The SDK must refuse to continue if\n`params_sha256` differs from its own hash (reference vector in API_CONTRACT.md).",
        "operationId": "create_pending_confirmation_endpoint_v1_confirmations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PendingConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingConfirmationResponse"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`: Missing or invalid field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "bad_request",
                    "message": "Missing or invalid field"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`session_expired`: Unknown or expired session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "session_expired",
                    "message": "Unknown or expired session_id"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/confirmations/{id}/confirm": {
      "post": {
        "tags": [
          "SDK (contract v1.1)"
        ],
        "summary": "Confirm and get a signed token",
        "description": "Single use. For `voice`, the utterance must be a strict confirmation phrase\n(\"confirm\", \"confirm transfer\"); \"yes\", \"okay\" and anything with a negation are rejected.\nSensitive actions also need `auth`: an ES256 signature from the session's device key over\n`accessai-auth-v1|{session_id}|{pending_id}|{action_id}|{params_sha256}`.",
        "operationId": "confirm_action_v1_confirmations__id__confirm_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmResponse"
                }
              }
            }
          },
          "401": {
            "description": "`auth_invalid`: Sensitive action without a valid device signature; `session_expired`: Unknown or expired session_id",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "auth_invalid",
                    "message": "Sensitive action without a valid device signature"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: Unknown pending_id, or it belongs to another session",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Unknown pending_id, or it belongs to another session"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`confirmation_used`: Already confirmed or cancelled",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "confirmation_used",
                    "message": "Already confirmed or cancelled"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "`confirmation_expired`: Confirmed after expires_at",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "confirmation_expired",
                    "message": "Confirmed after expires_at"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`not_a_confirmation`: Voice utterance is not a strict confirmation phrase",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "not_a_confirmation",
                    "message": "Voice utterance is not a strict confirmation phrase"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/confirmations/{id}/cancel": {
      "post": {
        "tags": [
          "SDK (contract v1.1)"
        ],
        "summary": "Cancel a pending confirmation",
        "description": "Idempotent: cancelling twice returns 204. Returns `confirmation_used` if it was\nalready confirmed.",
        "operationId": "cancel_action_v1_confirmations__id__cancel_post",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "description": "`bad_request`: Missing or invalid field",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "bad_request",
                    "message": "Missing or invalid field"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "`not_found`: Unknown pending_id, or it belongs to another session",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Unknown pending_id, or it belongs to another session"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`confirmation_used`: Already confirmed or cancelled",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "confirmation_used",
                    "message": "Already confirmed or cancelled"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "Bank backend"
        ],
        "summary": "Public keys for verifying tokens",
        "description": "Before executing a sensitive action the bank backend must: verify the token's EdDSA\nsignature against these keys (matching `kid`) and its `exp`; check `aid` is the action\nit is about to run; recompute the canonical SHA-256 of the exact params it received and\ncompare to `ph`; and reject any `jti` it has seen before.",
        "operationId": "get_jwks__well_known_jwks_json_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "keys": [
                    {
                      "kty": "OKP",
                      "crv": "Ed25519",
                      "kid": "accessai-fly-1",
                      "use": "sig",
                      "alg": "EdDSA",
                      "x": "UrEEBnzChlPMqcKtwWItJr3W6uIdOFaTIgvspefMt48"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Ops"
        ],
        "summary": "Health check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "The session that created the confirmation"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "default": "user_cancelled"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "CancelRequest",
        "examples": [
          {
            "session_id": "s_8f2c41d0a7b94e31"
          }
        ]
      },
      "ConfirmRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "The session that created the confirmation"
          },
          "pending_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending Id",
            "deprecated": true
          },
          "confirmation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmation Id",
            "deprecated": true
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method",
            "description": "\"voice\" (utterance is checked against a strict phrase list) or \"touch\"",
            "default": "voice"
          },
          "utterance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Utterance",
            "description": "For voice: e.g. \"confirm\" or \"confirm transfer\""
          },
          "auth": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceAuth"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for sensitive actions"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "ConfirmRequest",
        "examples": [
          {
            "auth": {
              "alg": "ES256",
              "kid": "device-1",
              "method": "biometric",
              "signature": "MEUCIQD…"
            },
            "method": "voice",
            "session_id": "s_8f2c41d0a7b94e31",
            "utterance": "confirm transfer"
          }
        ]
      },
      "ConfirmResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "Compact JWS (EdDSA). Verify against /.well-known/jwks.json before executing"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce",
            "description": "Equals the token's jti; use as the idempotency key"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At",
            "description": "Token expiry, ISO 8601 UTC (at most 60 s)"
          },
          "confirmation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmation Id",
            "deprecated": true
          },
          "spoken_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spoken Prompt",
            "deprecated": true
          }
        },
        "type": "object",
        "required": [
          "status",
          "token",
          "nonce",
          "expires_at"
        ],
        "title": "ConfirmResponse",
        "examples": [
          {
            "expires_at": "2026-11-09T12:01:00Z",
            "nonce": "8b0e4f2a9c1d",
            "status": "confirmed",
            "token": "eyJhbGciOiJFZERTQSIsImtpZCI6ImFjY2Vzc2FpLWZseS0xIn0.eyJpc3MiOiJhY2Nlc3NhaSJ9.c2ln"
          }
        ]
      },
      "DeviceAuth": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method",
            "description": "Device unlock method: 'biometric' or 'device_credential'. Becomes the token's amr claim",
            "default": "biometric"
          },
          "kid": {
            "type": "string",
            "title": "Kid",
            "description": "Key ID matching session device_key.kid"
          },
          "alg": {
            "type": "string",
            "title": "Alg",
            "description": "Signature algorithm (ES256)",
            "default": "ES256"
          },
          "signature": {
            "type": "string",
            "title": "Signature",
            "description": "Base64 DER ECDSA signature over accessai-auth-v1|{session_id}|{pending_id}|{action_id}|{params_sha256}"
          }
        },
        "type": "object",
        "required": [
          "kid",
          "signature"
        ],
        "title": "DeviceAuth"
      },
      "DeviceKey": {
        "properties": {
          "kid": {
            "type": "string",
            "title": "Kid",
            "description": "Key ID; confirm requests must sign with the same kid"
          },
          "alg": {
            "type": "string",
            "title": "Alg",
            "description": "Only ES256 (ECDSA P-256) is accepted",
            "default": "ES256"
          },
          "public_key": {
            "type": "string",
            "title": "Public Key",
            "description": "Base64 X.509 SubjectPublicKeyInfo DER encoded ECDSA public key"
          },
          "attestation_chain": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attestation Chain",
            "description": "Optional list of base64 DER X.509 certificates proving hardware backing"
          }
        },
        "type": "object",
        "required": [
          "kid",
          "public_key"
        ],
        "title": "DeviceKey"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable error code; see the error table in API_CONTRACT.md",
            "examples": [
              "not_a_confirmation"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable detail for logs; never shown to users"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "Body of every non-2xx response."
      },
      "InterpretRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id",
            "description": "From POST /v1/sessions"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "The user's utterance"
          },
          "utterance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Utterance",
            "deprecated": true
          },
          "actions": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actions",
            "description": "The host's allowlist. The ONLY actions that may be returned"
          },
          "manifest": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manifest",
            "deprecated": true
          },
          "screen_descriptor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screen Descriptor",
            "deprecated": true
          },
          "screen": {
            "title": "Screen",
            "description": "Current screen descriptor (optional)"
          },
          "dialog": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dialog",
            "description": "What AccessAI is in the middle of, if anything"
          },
          "dialog_state": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dialog State",
            "deprecated": true
          },
          "locale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locale",
            "description": "BCP 47 locale hint"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "InterpretRequest",
        "examples": [
          {
            "actions": [
              {
                "description": "Send money to a saved beneficiary",
                "examples": [
                  "send 5000 naira to David"
                ],
                "id": "transfer_money",
                "name": "send money",
                "params": [
                  {
                    "description": "Beneficiary name as the user said it",
                    "name": "recipient",
                    "required": true,
                    "type": "string"
                  },
                  {
                    "description": "Amount in kobo",
                    "name": "amount_minor",
                    "required": true,
                    "type": "amount_minor"
                  }
                ],
                "requires_confirmation": true,
                "sensitivity": "sensitive"
              }
            ],
            "dialog": {
              "awaiting": "none",
              "filled_params": {},
              "missing_params": []
            },
            "locale": "en-NG",
            "screen": {
              "elements": [],
              "screen_id": "home",
              "title": "Home"
            },
            "session_id": "s_8f2c41d0a7b94e31",
            "text": "Send 5,000 to David"
          }
        ]
      },
      "InterpretResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
