{
  "$defs": {
    "DeviceAuth": {
      "properties": {
        "method": {
          "default": "biometric",
          "description": "Device unlock method: 'biometric' or 'device_credential'. Becomes the token's amr claim",
          "title": "Method",
          "type": "string"
        },
        "kid": {
          "description": "Key ID matching session device_key.kid",
          "title": "Kid",
          "type": "string"
        },
        "alg": {
          "default": "ES256",
          "description": "Signature algorithm (ES256)",
          "title": "Alg",
          "type": "string"
        },
        "signature": {
          "description": "Base64 DER ECDSA signature over accessai-auth-v1|{session_id}|{pending_id}|{action_id}|{params_sha256}",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "kid",
        "signature"
      ],
      "title": "DeviceAuth",
      "type": "object"
    }
  },
  "examples": [
    {
      "auth": {
        "alg": "ES256",
        "kid": "device-1",
        "method": "biometric",
        "signature": "MEUCIQD…"
      },
      "method": "voice",
      "session_id": "s_8f2c41d0a7b94e31",
      "utterance": "confirm transfer"
    }
  ],
  "properties": {
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required: the session that created the confirmation",
      "title": "Session Id"
    },
    "pending_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "deprecated": true,
      "title": "Pending Id"
    },
    "confirmation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "deprecated": true,
      "title": "Confirmation Id"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "voice",
      "description": "\"voice\" (utterance is checked against a strict phrase list) or \"touch\"",
      "title": "Method"
    },
    "utterance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "For voice: e.g. \"confirm\" or \"confirm transfer\"",
      "title": "Utterance"
    },
    "auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceAuth"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required for sensitive actions"
    }
  },
  "title": "ConfirmRequest",
  "type": "object"
}
